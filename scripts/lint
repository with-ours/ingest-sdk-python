#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
if [ "${1:-}" = "--fix" ]; then
  uv run --locked --all-extras ruff check --fix .
else
  uv run --locked --all-extras ruff check .
fi
uv run --locked --all-extras pyright
uv run --locked --all-extras mypy .
uv run --locked --all-extras python -c 'import ours_privacy'
